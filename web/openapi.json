            "title": "Temperatures",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "temperatures"
        ],
        "title": "ModifierOption",
        "type": "object"
      },
      "Order": {
        "description": "An order as served by every order endpoint and both event\npayloads. Status changes live here; the daily number is short\nand callable (FR-3).",
        "example": {
          "createdAt": "2026-09-03T15:04:05Z",
          "customerName": "Lan",
          "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "items": [
            {
              "coldFoamId": "foam-salted",
              "coldFoamName": "Salted Cold Foam",
              "itemId": "matcha-sua",
              "itemName": "Matcha Latte",
              "itemNameVi": "Matcha Sữa",
              "milkOptionId": "oat-milk",
              "milkOptionName": "Oat milk",
              "notes": null,
              "quantity": 2,
              "sweetenerTypeId": "condensed-milk",
              "sweetenerTypeName": "Condensed milk",
              "sweetnessLevelId": "50",
              "sweetnessLevelName": "50%",
              "temperature": "iced"
            }
          ],
          "orderNumber": 7,
          "status": "placed",
          "updatedAt": "2026-09-03T15:04:05Z"
        },
        "properties": {
          "id": {
            "description": "Order id, stable across its lifetime.",
            "examples": [
              "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "orderNumber": {
            "description": "Daily order number, reset each day.",
            "examples": [
              7
            ],
            "minimum": 1,
            "title": "Ordernumber",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "Current lifecycle status."
          },
          "customerName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Guest-given name, if any.",
            "examples": [
              "Lan"
            ],
            "title": "Customername"
          },
          "items": {
            "description": "Line snapshots with resolved names.",
            "items": {
              "$ref": "#/components/schemas/OrderLineView"
            },
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "createdAt": {
            "description": "Placement time, ISO 8601 UTC.",
            "examples": [
              "2026-09-03T15:04:05Z"
            ],
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "updatedAt": {
            "description": "Last transition time, ISO 8601 UTC.",
            "examples": [
              "2026-09-03T15:09:11Z"
            ],
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderNumber",
          "status",
          "items",
          "createdAt",
          "updatedAt"
        ],
        "title": "Order",
        "type": "object"
      },
      "OrderCreate": {
        "description": "Request body of POST /api/orders.",
        "example": {
          "customerName": "Lan",
          "items": [
            {
              "coldFoamId": "foam-salted",
              "itemId": "matcha-sua",
              "milkOptionId": "oat-milk",
              "notes": "extra hot, please",
              "quantity": 2,
