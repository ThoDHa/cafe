                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional name shown to the barista on the queue card.",
            "examples": [
              "Lan"
            ],
            "title": "Customername"
          },
          "items": {
            "description": "Order lines; at least one.",
