{
  "openapi": "3.1.0",
  "info": {
    "title": "Cafe Ông Thọ ordering API",
    "description": "Ordering API for the Cafe Ông Thọ home cafe. Guests browse the menu, customize drinks within each item's rules, and follow their order's status live; the barista surface works the queue and moves orders through placed, in_progress, completed, or cancelled. Liveness arrives over Server-Sent Events at /api/events. The menu is the five drink sections of the recipes (Cà Phê, Mát-cha, Trà, Giải Khát, Kem) with the customization model frozen for v1: temperature, milk, sweetener type, sweetness level, cold foam on iced only, notes up to 200 characters, quantity 1 to 10 per line.",
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ApiError": {
        "description": "Error shape for 422 validation and transition rejections and\n404 unknown orders: a specific message plus per-line detail\nstrings (FR-7).",
        "example": {
          "details": [
            "item tan-cha is not on the menu"
          ],
          "error": "order line 1 is invalid"
        },
        "properties": {
          "error": {
            "description": "What went wrong, in one sentence.",
            "examples": [
              "order line 1 is invalid"
            ],
            "title": "Error",
            "type": "string"
          },
          "details": {
            "description": "Specific per-problem messages.",
            "examples": [
              [
                "item tan-cha is not on the menu"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Details",
            "type": "array"
          }
        },
        "required": [
          "error",
          "details"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Category": {
        "description": "One of the five drink sections of the recipes menu.",
        "example": {
          "id": "ca-phe",
          "name": "Coffee",
          "nameVi": "Cà Phê"
        },
        "properties": {
          "id": {
            "description": "Stable category slug, e.g. ca-phe.",
            "examples": [
              "ca-phe"
            ],
            "title": "Id",
            "type": "string"
          },
          "nameVi": {
            "description": "Section heading as printed on the recipes menu.",
            "examples": [
              "Cà Phê"
            ],
            "title": "Namevi",
            "type": "string"
          },
          "name": {
            "description": "English section label.",
            "examples": [
              "Coffee"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nameVi",
          "name"
        ],
        "title": "Category",
        "type": "object"
      },
      "HeartbeatEvent": {
        "description": "SSE keepalive sent every 25 seconds so idle connections and\nproxies keep the stream open.",
        "example": {
          "sentAt": "2026-09-03T15:04:30Z",
          "type": "heartbeat"
        },
        "properties": {
          "type": {
            "const": "heartbeat",
            "description": "Event discriminator.",
            "examples": [
              "heartbeat"
            ],
            "title": "Type",
            "type": "string"
          },
          "sentAt": {
            "description": "Heartbeat time, ISO 8601 UTC.",
            "examples": [
              "2026-09-03T15:04:30Z"
            ],
            "format": "date-time",
            "title": "Sentat",
            "type": "string"
          }
        },
        "required": [
          "type",
          "sentAt"
        ],
        "title": "HeartbeatEvent",
        "type": "object"
      },
      "MenuDocument": {
        "description": "The full validated menu served at GET /api/menu.",
        "example": {
          "categories": [
            {
              "id": "ca-phe",
              "name": "Coffee",
              "nameVi": "Cà Phê"
            }
          ],
          "items": [
            {
              "categoryId": "mat-cha",
              "description": "Koicha whisked thick, your sweetener and milk of choice.",
              "id": "matcha-sua",
              "imagePath": null,
              "modifierGroupIds": [
                "milk-matcha-latte",
                "sweetener-matcha",
                "sweetness",
                "cold-foam"
              ],
              "name": "Matcha Latte",
              "nameVi": "Matcha Sữa",
              "temperatures": [
                "hot",
                "iced"
              ]
            }
          ],
          "modifierGroups": [
            {
              "defaultByTemperature": {
                "hot": "whole-milk",
                "iced": "oat-milk"
              },
              "dimension": "milk",
              "id": "milk-matcha-latte",
              "name": "Milk",
              "options": [
                {
                  "id": "whole-milk",
                  "name": "Whole milk",
                  "temperatures": [
                    "hot"
                  ]
                },
                {
                  "id": "oat-milk",
                  "name": "Oat milk",
                  "temperatures": [
                    "hot",
                    "iced"
                  ]
                }
              ],
              "required": true
            }
          ],
          "orderRules": {
            "maxQuantity": 10,
            "minQuantity": 1,
            "notesMaxLength": 200
          },
          "version": 1
        },
        "properties": {
          "version": {
            "description": "Menu document format version.",
            "examples": [
              1
            ],
            "title": "Version",
            "type": "integer"
          },
          "orderRules": {
            "$ref": "#/components/schemas/OrderRules",
            "description": "Frozen per-line bounds."
          },
          "categories": {
            "description": "The five drink sections in display order.",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "title": "Categories",
            "type": "array"
          },
          "modifierGroups": {
            "description": "Shared customization groups referenced by items.",
            "items": {
              "$ref": "#/components/schemas/ModifierGroup"
            },
            "title": "Modifiergroups",
            "type": "array"
          },
          "items": {
            "description": "Every orderable drink.",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "version",
          "orderRules",
          "categories",
          "modifierGroups",
          "items"
        ],
        "title": "MenuDocument",
        "type": "object"
      },
      "MenuItem": {
        "description": "One orderable drink with its customization allowance.",
        "example": {
          "categoryId": "mat-cha",
          "description": "Koicha whisked thick, your sweetener and milk of choice.",
          "id": "matcha-sua",
          "imagePath": null,
          "modifierGroupIds": [
            "milk-matcha-latte",
            "sweetener-matcha",
            "sweetness",
            "cold-foam"
          ],
          "name": "Matcha Latte",
          "nameVi": "Matcha Sữa",
          "temperatures": [
            "hot",
            "iced"
          ]
        },
        "properties": {
          "id": {
            "description": "Stable item slug, e.g. matcha-sua.",
            "examples": [
              "matcha-sua"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "English name.",
            "examples": [
              "Matcha Latte"
            ],
            "title": "Name",
            "type": "string"
          },
          "nameVi": {
            "description": "Vietnamese name as printed on the recipes menu.",
            "examples": [
              "Matcha Sữa"
            ],
            "title": "Namevi",
            "type": "string"
          },
          "description": {
            "description": "English description from the recipes menu.",
            "examples": [
              "Koicha whisked thick, your sweetener and milk of choice."
            ],
            "title": "Description",
            "type": "string"
          },
          "categoryId": {
            "description": "Owning category slug.",
            "examples": [
              "mat-cha"
            ],
            "title": "Categoryid",
            "type": "string"
          },
          "temperatures": {
            "description": "Offered service temperatures, at least one.",
            "examples": [
              [
                "hot",
                "iced"
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Temperature"
            },
            "title": "Temperatures",
            "type": "array"
          },
          "modifierGroupIds": {
            "description": "Customization groups allowed on this item, per cafe.md.",
            "examples": [
              [
                "milk-matcha-latte",
                "sweetener-matcha",
                "sweetness",
                "cold-foam"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Modifiergroupids",
            "type": "array"
          },
          "imagePath": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional photo served at /images/menu/<itemId>.<ext>; absent means the on-brand placeholder.",
            "examples": [
              "/images/menu/matcha-sua.jpg"
            ],
            "title": "Imagepath"
          }
        },
        "required": [
          "id",
          "name",
          "nameVi",
          "description",
          "categoryId",
          "temperatures",
          "modifierGroupIds"
        ],
        "title": "MenuItem",
        "type": "object"
      },
      "ModifierDimension": {
        "description": "Which frozen customization dimension a modifier group expresses.",
        "enum": [
          "milk",
          "sweetener_type",
          "sweetness_level",
          "cold_foam"
        ],
        "title": "ModifierDimension",
        "type": "string"
      },
      "ModifierGroup": {
        "description": "A customization group allowed on one or more menu items.",
        "example": {
          "defaultByTemperature": {
            "hot": "whole-milk",
            "iced": "oat-milk"
          },
          "dimension": "milk",
          "id": "milk-matcha-latte",
          "name": "Milk",
          "options": [
            {
              "id": "whole-milk",
              "name": "Whole milk",
              "temperatures": [
                "hot"
              ]
            },
            {
              "id": "oat-milk",
              "name": "Oat milk",
              "temperatures": [
                "hot",
                "iced"
              ]
            }
          ],
          "required": true
        },
        "properties": {
          "id": {
            "description": "Stable group slug, e.g. milk-matcha-latte.",
            "examples": [
              "milk-matcha-latte"
            ],
            "title": "Id",
            "type": "string"
          },
          "dimension": {
            "$ref": "#/components/schemas/ModifierDimension",
            "description": "Which customization dimension this group expresses."
          },
          "name": {
            "description": "Display name of the group.",
            "examples": [
              "Milk"
            ],
            "title": "Name",
            "type": "string"
          },
          "required": {
            "description": "True when the guest must make exactly one selection.",
            "examples": [
              true
            ],
            "title": "Required",
            "type": "boolean"
          },
          "options": {
            "description": "Selectable options, each scoped to temperatures.",
            "items": {
              "$ref": "#/components/schemas/ModifierOption"
            },
            "title": "Options",
            "type": "array"
          },
          "defaultOptionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Default selection when options do not vary by temperature.",
            "examples": [
              "condensed-milk"
            ],
            "title": "Defaultoptionid"
          },
          "defaultByTemperature": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Default selection per temperature when options vary by temperature, e.g. Matcha Sữa hot defaults to whole milk.",
            "examples": [
              {
                "hot": "whole-milk",
                "iced": "milk-plus-cream"
              }
            ],
            "title": "Defaultbytemperature"
          }
        },
        "required": [
          "id",
          "dimension",
          "name",
          "required",
          "options"
        ],
        "title": "ModifierGroup",
        "type": "object"
      },
      "ModifierOption": {
        "description": "One selectable option within a modifier group.",
        "example": {
          "id": "oat-milk",
          "name": "Oat milk",
          "temperatures": [
            "hot",
            "iced"
          ]
        },
        "properties": {
          "id": {
            "description": "Stable option slug, e.g. oat-milk.",
