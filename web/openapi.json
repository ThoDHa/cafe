            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "OrderCreate",
        "type": "object"
      },
      "OrderLine": {
        "description": "One drink line in a placed order: the full selection snapshot\n(FR-2). Validated against the live menu: the item must exist,\nthe temperature must be offered, and every selection must belong\nto a group the item allows at that temperature.",
        "example": {
          "coldFoamId": "foam-salted",
          "itemId": "matcha-sua",
          "milkOptionId": "oat-milk",
          "notes": "extra hot, please",
          "quantity": 2,
          "sweetenerTypeId": "condensed-milk",
          "sweetnessLevelId": "50",
          "temperature": "iced"
        },
        "properties": {
          "itemId": {
            "description": "Menu item id.",
            "examples": [
              "matcha-sua"
            ],
            "title": "Itemid",
            "type": "string"
          },
          "temperature": {
            "$ref": "#/components/schemas/Temperature",
            "description": "Chosen service temperature; must be offered by the item."
          },
          "quantity": {
            "description": "Units of this line, 1 to 10.",
            "examples": [
              2
            ],
            "maximum": 10,
            "minimum": 1,
            "title": "Quantity",
            "type": "integer"
          },
          "milkOptionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Chosen milk option; must belong to the item's milk group at the chosen temperature.",
            "examples": [
              "oat-milk"
            ],
            "title": "Milkoptionid"
          },
          "sweetenerTypeId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Chosen sweetener; must belong to the item's sweetener group.",
            "examples": [
              "condensed-milk"
            ],
            "title": "Sweetenertypeid"
          },
          "sweetnessLevelId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Chosen sweetness step; one of full, 75, 50, 25, none.",
            "examples": [
              "50"
            ],
            "title": "Sweetnesslevelid"
          },
          "coldFoamId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Chosen cold foam build; allowed only when temperature is iced.",
            "examples": [
              "foam-salted"
            ],
            "title": "Coldfoamid"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Free text for the barista, at most 200 characters.",
            "examples": [
              "extra hot, please"
            ],
            "title": "Notes"
          }
        },
        "required": [
          "itemId",
          "temperature",
          "quantity"
        ],
        "title": "OrderLine",
        "type": "object"
      },
