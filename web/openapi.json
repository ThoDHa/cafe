              "oat-milk"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Display name spelled out to guests and baristas.",
            "examples": [
              "Oat milk"
            ],
            "title": "Name",
            "type": "string"
          },
          "temperatures": {
            "description": "Service temperatures at which this option is offered.",
